#!/usr/bin/env bash
# OmaSession -- reopen the windows you had, where you had them.
#
#   omasession save [name]        capture the session (guarded)
#   omasession restore [name]     replay it into the compositor
#   omasession restore-browser [app]  move an existing browser's windows
#                                 (--if-enabled: só se restoreOnLogin estiver on)
#   omasession restore-app [app]     restore one app from the saved session
#   omasession status [--json]    what was captured, when, and what is wrong
#   omasession list [--json]      named sessions and the history of `last`
#   omasession layout [name]      a saved session as drawable geometry (JSON, for the panel)
#   omasession resolve [--json]   which command each open window resolves to
#   omasession install [--if-needed]  timer and login restore (--if-needed:
#                                 what the plugin's service runs on load)
#   omasession uninstall          undo install
#   omasession config get <key>   read one config value (empty if unset)
#   omasession config set <key> <value>   persist one config value
#
# Everything heavy lives here rather than in Panel.qml: a crash inside
# quickshell takes down the bar, the dock and the menu at once, and restoring
# has to work when there is no shell at all (docs/DESIGN.md §6). The panel only
# reads `status --json` and calls back into this script.

set -euo pipefail

# Nunca confiar no PATH herdado. O timer systemd e o autostart de login
# herdam o ambiente da sessão gráfica, que pode ter diretórios do próprio
# usuário (mise/asdf shims, ~/.local/bin, ~/bin, Homebrew) antes do sistema --
# medido nesta mesma máquina: `python3` e `flock` resolviam pro Homebrew, não
# pro `/usr/bin` do sistema, porque o PATH da sessão os lista primeiro. Um
# binário com o mesmo nome num desses diretórios rodaria automaticamente
# dentro da sessão do usuário, sem ninguém notar. Achado da revisão de
# segurança do marketplace (issue #6243). Todo processo filho (python3,
# session-save.sh, o replay) herda este PATH já fixado.
#
# /usr/local/{s,}bin entram também -- achado da revisão (omasession-12):
# ainda são root-owned num sistema padrão, não carregam o risco que motivou
# o pin, e é onde um Hyprland compilado da fonte (`make install`) instala
# `hyprctl` por padrão. Excluí-los faria o plugin inteiro parar de achar o
# compositor em silêncio numa instalação assim, o mesmo tipo de regressão
# que este pin existe pra evitar do lado oposto.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin

# A pinned list is only as trustworthy as the directories in it -- achado da
# revisão (issue #6243, retorno do HANCORE-linux): confia que /usr/local/*
# continua root-owned e não-gravável por padrão, sem nunca ter conferido.
# /usr/bin/python3 é fixo aqui de propósito -- este é o próprio script que
# prova que o PATH é confiável, então não pode confiar nele ainda pra se
# encontrar.
/usr/bin/python3 "${BASH_SOURCE[0]%/*}/../lib/verify_path.py" \
    || { printf 'omasession: %s\n' "PATH contains an untrusted directory -- refusing to run" >&2; exit 1; }

# SELF via expansão de parâmetro, não `dirname`/`readlink`: evita depender de
# um comando externo antes do PATH estar fixado e verificado.
SELF="$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)"
LIB="$SELF/lib"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omasession"
CONFIG="$CONFIG_DIR/config.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omasession"
SAVE_STATE="$STATE_DIR/last-save.json"
# Nosso diretório, não mais o do hyprresume -- ver lib/session-save.sh para o
# porquê da migração. Honra a mesma variável que ele, por consistência.
SESSION_DIR="${OMASESSION_SESSION_DIR:-$HOME/.local/share/omasession/sessions}"

# One claim per Hyprland instance for the login restore (cmd_restore). The
# runtime dir is a tmpfs, so a reboot starts with none.
LOGIN_CLAIM_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omasession"

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
# The shell's own config, read to know whether the plugin is enabled
# (plugin_enabled). Omarchy runs no hook of a plugin on disable or remove.
# The shell reads $HOME/.config/omarchy whatever XDG_CONFIG_HOME says.
SHELL_CONFIG_DIR="$HOME/.config/omarchy"
PLUGIN_ID="brenoperucchi.omasession"
AUTOSTART_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
AUTOSTART_NAME="autostart.lua"
AUTOSTART="$AUTOSTART_DIR/$AUTOSTART_NAME"

# Toda leitura/escrita de config.json, last-save.json e autostart.lua passa
# por aqui -- não por `> "$path"`/`cp`/`mv` direto. lib/safe_fs.py abre cada
# componente do caminho com O_NOFOLLOW a partir de "/", nunca reabrindo por
# string depois de checar; o achado original (issue #6243) era sobre o
# browser-setup, que roda como root, mas o revisor manteve isto bloqueando
# mesmo depois desse fix -- esta categoria nunca atravessa fronteira de
# privilégio (quem já tem acesso de escrita no $HOME do usuário já pode
# fazer qualquer coisa que o próprio usuário faz), mas o mesmo padrão foi
# aplicado aqui a pedido do revisor.
SAFE_FS="$LIB/safe_fs.py"
safe_read() { python3 "$SAFE_FS" read "$1" "$2" 2>/dev/null; }
safe_write() { python3 "$SAFE_FS" write --create "$1" "$2" "${3:-600}"; }
safe_copy()  { python3 "$SAFE_FS" copy --create "$1" "$2" "$3" 2>/dev/null; }

# safe_read sai com 3 quando o arquivo/diretório simplesmente não existe
# ainda (instalação nova, nenhuma sessão salva ainda) e com 1 pra qualquer
# outra coisa (symlink recusado na cadeia, arquivo maior que o teto). Todo
# call site abaixo precisa das DUAS partes: capturar sem deixar o `set -e`
# abortar a atribuição (achado omasession-14 -- `local x; x="$(safe_read
# ...)"` como duas declarações é uma atribuição simples, e sob `set -e` uma
# falha ali mata o script antes mesmo do `[[ -z/-n ]]` que já tratava o caso
# como normal), E distinguir os dois códigos (achado omasession-14/15 rev-2
# -- colapsar tudo em string vazia faz uma recusa de segurança de verdade
# desaparecer em silêncio, e um arquivo que existe mas está vazio de verdade
# virar indistinguível de "não existe"). O idioma:
#
#   local x rc; x="$(safe_read "$dir" "$name")" && rc=0 || rc=$?
#   (( rc == 0 || rc == 3 )) || safe_read_die "$rc" "$path"
#
# `x="$(cmd)" && rc=0 || rc=$?` nunca deixa o `set -e` dessa linha disparar
# (o `||`/`&&` externo sempre resolve pra sucesso), mas ainda captura o
# código real de `cmd` em `rc` -- ao contrário de `x="$(cmd)" || rc=$?`
# sozinho, que deixaria `rc` sem valor no caminho de sucesso.
#
# autostart.lua tem uma exigência a mais: o ciclo install/uninstall precisa
# devolver o arquivo idêntico (comentário em remove_login_restore), e
# `$(safe_read ...)` come toda newline final do jeito que `$(...)` sempre
# faz -- inofensivo pra config.json/last-save.json (sempre regenerados do
# zero por jq), não pra um arquivo editado à mão que este script só
# acrescenta/remove um trecho marcado. O sentinela `X` protege as newlines
# reais (que deixam de ser as últimas do stream) contra ESSE `$(...)`
# interno -- mas não contra outro por cima. A primeira versão disto devolvia
# o conteúdo por `printf` e deixava quem chama fazer `content="$(safe_read_
# exact ...)"`, e essa segunda captura comia a newline de novo, do mesmo
# jeito -- achado omasession-16 (rev-2, medido com od -c): a proteção nunca
# saía da própria função. `printf -v` na variável do CHAMADOR (via nameref)
# em vez de stdout+`$(...)` evita ter uma segunda camada pra proteger.
safe_read_exact_into() { # safe_read_exact_into <var> <dir> <name>
    local -n _dst="$1"
    local out rc
    out="$(safe_read "$2" "$3"; rc=$?; printf X; exit "$rc")" && rc=0 || rc=$?
    printf -v _dst '%s' "${out%X}"
    return "$rc"
}

toml_windows() {
    [[ -f "$1" ]] || { echo 0; return; }
    python3 - "$1" <<'PY' 2>/dev/null || echo 0
import sys, tomllib
with open(sys.argv[1], "rb") as fh:
    print(len(tomllib.load(fh).get("window", [])))
PY
}

say()  { printf 'omasession: %s\n' "$*"; }
err()  { printf 'omasession: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# safe_read_die <rc> <path> -- morre com uma mensagem que reflete o motivo
# de verdade, não uma frase genérica só -- achado omasession-17 (rev-2):
# lib/safe_fs.py agora sai com códigos distintos (1 recusa de confiança de
# verdade, 4 arquivo maior que o teto, 5 outro erro de I/O), mas toda
# chamada aqui ainda dizia "failed the directory-chain trust check" pros
# três, então um config.json de 9 MiB e um symlink recusado produziam a
# mesma mensagem, nenhuma das duas certa pro caso de tamanho.
safe_read_die() {
    case "$1" in
        4) die "refusing $2: larger than the size limit" ;;
        1) die "refusing $2: failed the directory-chain trust check (wrong owner, writable by others, or an untrusted symlink)" ;;
        *) die "refusing $2: unexpected error reading it (rc=$1)" ;;
    esac
}

# Mesma checagem de lib/session-save.sh, mesmo motivo (achado omasession-18,
# rev-2): OMASESSION_SESSION_DIR fora de $HOME nunca foi documentado nem
# testado, e reabriria a exceção de sticky bit do safe_fs.py como precondição
# alcançável pra corrida no lock file do save. Recusado aqui também, não só
# no save, pra falhar cedo em qualquer subcomando que use SESSION_DIR.
case "$SESSION_DIR" in
    "$HOME"/*) ;;
    *) die "OMASESSION_SESSION_DIR must be inside \$HOME (got: $SESSION_DIR)" ;;
esac

# ── configuration ────────────────────────────────────────────────────────────
# The manifest declares these under barWidget.schema, which is the quickshell
# preference store -- unreachable from a systemd timer or from a login-time
# restore, which are exactly the two places that need them. So the file below
# is the source of truth and the panel writes it; the manifest only supplies
# the defaults a fresh install starts from.
DEFAULT_SAVE_INTERVAL=30
DEFAULT_RESTORE_ON_LOGIN=true
DEFAULT_BROWSER_RESTORE=true
DEFAULT_BROWSER_REPAIR=true
DEFAULT_BROWSER_REPAIR_CHROME=true
DEFAULT_APP_RESTORE_GHOSTTY=true
DEFAULT_RESTORE_ORDER=auto

config_get() { # config_get <key> <default> [raw_json]
    # $3, quando dado, poupa uma leitura de config.json que quem chama já fez
    # -- achado omasession-15 (P3, custo): status_json chamava isto duas
    # vezes, cada uma relendo o arquivo do zero com seu próprio processo
    # python3, medido em ~54ms extras por chamada de status --json. Mesma
    # ideia já usada logo abaixo pra save_state: ler uma vez, extrair várias
    # chaves da mesma string.
    local raw
    if (( $# >= 3 )); then
        raw="$3"
    else
        local rc; raw="$(safe_read "$CONFIG_DIR" config.json)" && rc=0 || rc=$?
        # rc==4 (grande demais) degrada pro default aqui de propósito,
        # diferente de cmd_install/cmd_config-set abaixo -- achado
        # omasession-17 (rev-2): esta função só LÊ um valor pra exibir ou
        # decidir comportamento, nunca escreve; travar o comando inteiro
        # porque o arquivo é grande demais é pior que mostrar o default.
        (( rc == 0 || rc == 3 || rc == 4 )) || safe_read_die "$rc" "$CONFIG"
    fi
    [[ -n "$raw" ]] || { printf '%s' "$2"; return; }
    local v
    # `// empty` trata false como ausente, então `restoreOnLogin: false` caía no
    # default `true` e o install adicionava a linha de login mesmo assim -- uma
    # opção que o usuário desligou e o programa ignorou em silêncio. `has` é o
    # que distingue chave ausente de valor falso.
    v="$(jq -r --arg k "$1" 'if has($k) and .[$k] != null then .[$k] else empty end' \
         <<<"$raw" 2>/dev/null)" || v=""
    [[ -n "$v" ]] && printf '%s' "$v" || printf '%s' "$2"
}

# ── hyprland ─────────────────────────────────────────────────────────────────
hypr_env() {
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
        export HYPRLAND_INSTANCE_SIGNATURE
    fi
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]
}

# ── enabled ──────────────────────────────────────────────────────────────────
# Whether omarchy-shell has the plugin enabled, by the same rules as its
# PluginRegistry.isEnabled: listed in the bar layout (or in `plugins`) and not
# in `disabledPlugins`. A shell.json that is missing, unparsable or without
# `version: 1` makes the shell use its defaults, which never list a
# third-party plugin. `omarchy plugin remove` disables before it deletes, so
# this also stops a checkout that outlives a symlinked install.
#
# Only the automatic paths ask (the timer's save, the login restore). They
# keep running from systemd and autostart.lua after the plugin is disabled or
# removed, and Omarchy gives the plugin no hook to stop them.
plugin_enabled() {
    local raw
    raw="$(safe_read "$SHELL_CONFIG_DIR" shell.json)" || return 1
    jq -e --arg id "$PLUGIN_ID" '
        def arr: if type == "array" then . else [] end;
        def obj: if type == "object" then . else {} end;
        def entry_id: if type == "object" then .id else . end;
        type == "object" and .version == 1
        and ((.disabledPlugins | arr | index($id)) == null)
        and ((.bar | obj | .id) == $id
             or ([(.bar | obj | .layout | obj) as $l
                  | ($l.left, $l.center, $l.right) | arr | .[] | entry_id]
                 | index($id)) != null
             or ([.plugins | arr | .[] | objects | .id] | index($id)) != null)
    ' >/dev/null 2>&1 <<<"$raw"
}

# ── save ─────────────────────────────────────────────────────────────────────
cmd_save() {
    # --if-enabled is what the snapshot timer runs.
    if [[ "${1:-}" == "--if-enabled" ]]; then
        shift
        if ! plugin_enabled; then
            say "the plugin is not enabled in omarchy-shell -- nothing to do"
            return 0
        fi
    fi
    local name="${1:-last}" out rc repair repair_chrome terminal_programs
    repair="$(config_get browserRepair "$DEFAULT_BROWSER_REPAIR")"
    # terminalPrograms: comma list of programs to relaunch inside their
    # terminal (e.g. "nvim,btop"); empty by default (lib/capture.py).
    terminal_programs="$(config_get terminalPrograms "")"
    repair_chrome="$(config_get browserRepairChrome "$DEFAULT_BROWSER_REPAIR_CHROME")"
    set +e
    out="$(OMASESSION_BROWSER_REPAIR="$repair" \
        OMASESSION_TERMINAL_PROGRAMS="$terminal_programs" \
        OMASESSION_BROWSER_REPAIR_CHROME="$repair_chrome" OMASESSION_STATE_DIR="$STATE_DIR" \
        "$LIB/session-save.sh" "$name" 2>&1)"; rc=$?
    set -e
    printf '%s\n' "$out"

    # Record the outcome so `status` can report a refusal instead of leaving it
    # in the journal. A guard that protects the session silently looks exactly
    # like a guard that never ran.
    local windows; windows="$(toml_windows "$SESSION_DIR/$name.toml")"
    # Mesmo cuidado do cmd_config: monta antes de publicar, pra um jq -n que
    # falhasse (não deveria, os args são todos nossos, mas o -- "|| true"
    # abaixo existe justamente pra nunca deixar a contabilidade derrubar o
    # rc do save de verdade) não conseguir publicar um last-save.json vazio
    # por cima do anterior.
    local record
    if record="$(jq -n --arg when "$(date -u +%FT%TZ)" --argjson rc "$rc" \
          --arg message "$(printf '%s' "$out" | tail -1)" \
          --argjson windows "$windows" --arg name "$name" \
          '{when:$when, rc:$rc, message:$message, windows:$windows, name:$name}')"; then
        printf '%s\n' "$record" | safe_write "$STATE_DIR" last-save.json || true
    fi
    return $rc
}

# ── restore ──────────────────────────────────────────────────────────────────
cmd_restore() {
    # --if-enabled é o que a linha do autostart.lua chama. A linha existe
    # sempre; quem decide é o config. Antes havia DUAS fontes de verdade -- o
    # `restoreOnLogin` do config e a presença da linha -- e o interruptor do
    # painel escrevia só a primeira, então desligá-lo não desligava nada. Uma
    # opção que o programa ignora é o defeito que este projeto acusa nos outros.
    local login=0
    if [[ "${1:-}" == "--if-enabled" ]]; then
        shift
        if [[ "$(config_get restoreOnLogin "$DEFAULT_RESTORE_ON_LOGIN")" == "false" ]]; then
            say "restore on login is off -- nothing to do"
            return 0
        fi
        if ! plugin_enabled; then
            say "the plugin is not enabled in omarchy-shell -- nothing to do"
            return 0
        fi
        login=1
    fi
    local name="${1:-last}"
    hypr_env || die "no Hyprland instance -- nothing to restore into"
    # The login restore runs once per Hyprland instance. More than one line in
    # autostart.lua can reach it in the same login (an installed copy next to a
    # development checkout, say), and a second restore would reshuffle a
    # desktop already in use. The claim is taken under the lock below, so a restore
    # that never starts leaves it free; this early look only spares a later
    # caller the wait on that lock.
    local claim_name="login-restore.$HYPRLAND_INSTANCE_SIGNATURE"
    if (( login )) && safe_read "$LOGIN_CLAIM_DIR" "$claim_name" >/dev/null; then
        say "already restored for this login -- nothing to do"
        return 0
    fi
    [[ -f "$SESSION_DIR/$name.toml" ]] || die "no saved session at $SESSION_DIR/$name.toml"

    # O restore toma o MESMO lock que o save, e o segura ate o fim.
    #
    # Sem isto os dois correm: restaurando 6 janelas, se o timer dispara com 1
    # na tela, o guard ve count_old=6, count_screen=1, count_new=1 -- e as duas
    # regras deixam publicar, porque "a tela encolheu" e um encolhimento
    # legitimo do ponto de vista dele. O proprio fluxo recem-instalado
    # substituiria a sessao completa pela parcialmente restaurada. Achado da
    # rodada 2; o guard sozinho nao podia ver a diferenca, porque a informacao
    # que falta ("estamos no meio de um restore") nao esta na tela.
    #
    # `exec` abaixo troca este shell pelo replay, mas o descritor 9 sobrevive a
    # troca: o lock fica seguro pelo processo do replay e e liberado quando ele
    # termina, inclusive se ele morrer.
    # `>>`, not `>`: opening the lock must never truncate whatever it names.
    # A timer save takes a few seconds; wait for it rather than fail.
    exec 9>>"$SESSION_DIR/.$name.lock"
    if ! flock -w 10 9; then
        die "a save or restore is running -- refusing to restore on top of it"
    fi
    # Restoring another name (`work`, a history snapshot) parks windows just the
    # same, so the timer's save of `last` has to wait for it too -- otherwise it
    # can publish the half-restored desktop over `last`.
    if [[ "$name" != last ]]; then
        exec 8>>"$SESSION_DIR/.last.lock"
        if ! flock -w 10 8; then
            die "a save or restore is running -- refusing to restore on top of it"
        fi
    fi

    if (( login )); then
        local claim_rc
        python3 "$SAFE_FS" claim --create "$LOGIN_CLAIM_DIR" "$claim_name" && claim_rc=0 || claim_rc=$?
        case "$claim_rc" in
            0) ;;
            6) say "already restored for this login -- nothing to do"; return 0 ;;
            *) die "could not record the login restore in $LOGIN_CLAIM_DIR -- refusing to restore twice" ;;
        esac
    fi

    # browserRestore ainda nao e respeitado: replay.py nao le a opcao. Dizer
    # isso e melhor que exportar uma variavel que ninguem consome -- uma opcao
    # que finge funcionar e exatamente o defeito que este projeto existe para
    # combater.
    if [[ "$(config_get browserRestore "$DEFAULT_BROWSER_RESTORE")" == "false" ]]; then
        err "browserRestore=false ainda nao e respeitado; os browsers vao reabrir suas janelas"
    fi
    local restore_ghostty restore_order
    restore_ghostty="$(config_get appRestoreGhostty "$DEFAULT_APP_RESTORE_GHOSTTY")"
    # restoreOrder: put windows back in their saved slot order (replay.py).
    # auto (the default) does it only when the Lua config reports the order.
    restore_order="$(config_get restoreOrder "$DEFAULT_RESTORE_ORDER")"
    OMASESSION_APP_RESTORE_GHOSTTY="$restore_ghostty" \
    OMASESSION_RESTORE_ORDER="$restore_order" \
        exec python3 "$LIB/replay.py" "$SESSION_DIR/$name.toml"
}

# ── restore-browser ─────────────────────────────────────────────────────────
# This is the explicit, app-only action exposed by the panel's small Chrome
# button. It deliberately shares the last-session lock with save/restore: a
# manual move must not race the snapshot that supplies its destinations.
cmd_restore_browser() {
    local app="${1:-google-chrome}"
    case "$app" in
        chromium|google-chrome|brave-browser|vivaldi-stable) ;;
        *) die "unsupported browser class: $app" ;;
    esac
    hypr_env || die "no Hyprland instance -- nothing to restore into"
    [[ -f "$SESSION_DIR/last.toml" ]] || die "no saved session at $SESSION_DIR/last.toml"

    # Reuse safe_fs' descriptor-preserving lock wrapper, the same boundary as
    # session-save.sh. Re-entering this command with fd 9 already open means
    # the child can prove it owns the lock without trusting an environment
    # variable or reopening the path after a check.
    if ! : 2>/dev/null >&9; then
        exec /usr/bin/python3 "$LIB/safe_fs.py" exec-with-lock \
            "$SESSION_DIR" ".last.lock" 9 -- bash "${BASH_SOURCE[0]}" \
            restore-browser "$app"
    fi
    if ! flock -n 9; then
        die "another save or restore is already running"
    fi

    local clients rc repair_output detail
    if ! clients="$(timeout --kill-after=5 15 hyprctl clients -j 2>/dev/null)" \
        || [[ -z "$clients" ]]; then
        die "cannot read hyprctl clients -- browser placement unchanged"
    fi

    if repair_output="$(timeout --kill-after=5 90 python3 "$LIB/browser_repair.py" \
        "$SESSION_DIR/last.toml" "$STATE_DIR" --manual --app "$app" \
        <<<"$clients" 2>&1)"; then
        printf '%s\n' "$repair_output"
    else
        rc=$?
        printf '%s\n' "$repair_output"
        detail="$(printf '%s\n' "$repair_output" | tail -n 1)"
        if (( rc == 3 )); then
            die "browser placement repair was incomplete: ${detail:-no detail} -- saved snapshot unchanged"
        fi
        die "browser placement repair failed (rc=$rc): ${detail:-no detail} -- saved snapshot unchanged"
    fi
}

# ── restore-app ─────────────────────────────────────────────────────────────
# App-only actions share the same saved snapshot and lock as the full restore.
# Both Chrome and Ghostty use replay.py's app filter; restore-browser remains
# the separate repair path for moving windows that are already open.
cmd_restore_app() {
    local app="$*" filter
    case "$app" in
        google-chrome) filter="google-chrome" ;;
        ghostty) filter="com.mitchellh.ghostty" ;;
        *) die "unsupported app: ${app:-<none>} (try google-chrome or ghostty)" ;;
    esac
    hypr_env || die "no Hyprland instance -- nothing to restore into"
    [[ -f "$SESSION_DIR/last.toml" ]] || die "no saved session at $SESSION_DIR/last.toml"
    if ! : 2>/dev/null >&9; then
        exec /usr/bin/python3 "$SAFE_FS" exec-with-lock \
            "$SESSION_DIR" ".last.lock" 9 -- bash "${BASH_SOURCE[0]}" \
            restore-app "$app"
    fi
    if ! flock -n 9; then
        die "another save or restore is already running"
    fi
    local restore_order
    restore_order="$(config_get restoreOrder "$DEFAULT_RESTORE_ORDER")"
    exec env OMASESSION_APP_RESTORE_GHOSTTY=true \
        OMASESSION_RESTORE_ORDER="$restore_order" \
        python3 "$LIB/replay.py" --app "$filter" \
        "$SESSION_DIR/last.toml"
}

# ── status ───────────────────────────────────────────────────────────────────
# The JSON shape is the contract Panel.qml already renders against; keep the
# keys stable or the panel silently shows nothing.
status_json() {
    local name="${1:-last}"
    local toml="$SESSION_DIR/$name.toml" sidecar="$SESSION_DIR/$name.titles.json"

    # O que o RESTORE usaria, não o que está em last.toml. Um par rasgado manda
    # o replay para a geração anterior, e sem perguntar a ele o painel mostraria
    # uma sessão enquanto o botão restauraria outra.
    local effective side_used
    effective="$(python3 "$LIB/effective.py" "$toml" 2>/dev/null || echo '{}')"
    side_used="$(jq -r '.sidecar // ""' <<<"$effective")"
    local fallback; fallback="$(jq -r '.fallback // false' <<<"$effective")"
    local notes; notes="$(jq -c '.notes // []' <<<"$effective")"
    local windows; windows="$(jq -r '.windows // 0' <<<"$effective")"

    # The captured list carries what the panel needs to group and to be honest:
    # the workspace it belongs to, a name a person recognises, and whether the
    # resolver can actually bring it back. "Ready" is a claim; `resolvable` is
    # a claim we can support -- answered from the .desktop index, which needs no
    # live process, because the saved session describes windows already gone.
    local captured='[]'
    if [[ -n "$side_used" && -f "$side_used" ]]; then
        local toml_used="${side_used%.titles.json}.toml"
        captured="$(python3 "$LIB/captured.py" "$side_used" "$toml_used" 2>/dev/null || echo '[]')"
    fi

    workspaces="$(jq -c '[.[].ws] | unique | length' <<<"$captured" 2>/dev/null || echo 0)"

    # Age is measured from the session file, not from our own state file: the
    # question the user has is "how old is what would be restored", and only the
    # file that would be restored can answer it.
    local ago=-1 mtime
    if [[ -f "$toml" ]] && mtime="$(stat -c %Y "$toml" 2>/dev/null)"; then
        ago=$(( $(date +%s) - mtime ))
    fi

    local rc=0 message="" when=""
    # read_rc, não rc -- "rc" abaixo é o exit code que o ÚLTIMO SAVE reportou
    # (lido de dentro do save_state), um valor de domínio completamente
    # diferente do exit code desta leitura. Reusar o mesmo nome faria uma
    # instalação nova (save_state ausente, read_rc=3) ser lida como "o save
    # recusou" (rc==3 é exatamente o que session-save.sh usa pra "refused"),
    # marcando `refused=true` sem nunca ter havido save nenhum -- um bug de
    # verdade que só apareceu ao escrever este comentário.
    local save_state read_rc; save_state="$(safe_read "$STATE_DIR" last-save.json)" && read_rc=0 || read_rc=$?
    # rc==4 aceito aqui também -- status_json só exibe, nunca escreve.
    (( read_rc == 0 || read_rc == 3 || read_rc == 4 )) || safe_read_die "$read_rc" "$SAVE_STATE"
    if [[ -n "$save_state" ]]; then
        rc="$(jq -r '.rc // 0' <<<"$save_state" 2>/dev/null || echo 0)"
        message="$(jq -r '.message // ""' <<<"$save_state" 2>/dev/null || echo "")"
        when="$(jq -r '.when // ""' <<<"$save_state" 2>/dev/null || echo "")"
    fi
    local refused=false
    [[ "$rc" == "3" ]] && refused=true

    local timer="inactive"
    systemctl --user is-active --quiet omasession-snapshot.timer 2>/dev/null && timer="active"
    # The timer and the login restore do nothing while this is false.
    local plugin_on=false
    plugin_enabled && plugin_on=true

    # Use the same pair-selection rules as replay.py for app membership. The
    # sidecar is presentation data and may be absent even when a valid TOML
    # still carries launchable windows (or may belong to a previous generation).
    local effective_apps='{}'
    effective_apps="$(python3 - "$toml" "$LIB" 2>/dev/null <<'PY'
import contextlib
import io
import json
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[2])
import replay

with contextlib.redirect_stdout(io.StringIO()):
    windows, _titles, _sidecar = replay.load_pair(Path(sys.argv[1]))
counts = {}
for window in windows:
    app = window.get("app_id", "")
    if app:
        counts[app] = counts.get(app, 0) + 1
print(json.dumps(counts))
PY
)" || effective_apps='{}'

    local chrome_installed=false ghostty_installed=false
    command -v google-chrome-stable >/dev/null 2>&1 && chrome_installed=true
    command -v ghostty >/dev/null 2>&1 && ghostty_installed=true
    local chrome_captured=false ghostty_captured=false
    jq -e '(.["google-chrome"] // 0) > 0' >/dev/null 2>&1 <<<"$effective_apps" \
        && chrome_captured=true
    jq -e '((.["com.mitchellh.ghostty"] // 0) + (.ghostty // 0)) > 0' \
        >/dev/null 2>&1 <<<"$effective_apps" && ghostty_captured=true

    local cfg_raw cfg_rc
    cfg_raw="$(safe_read "$CONFIG_DIR" config.json)" && cfg_rc=0 || cfg_rc=$?
    # rc==4 aceito aqui também, mesmo motivo do save_state acima.
    (( cfg_rc == 0 || cfg_rc == 3 || cfg_rc == 4 )) || safe_read_die "$cfg_rc" "$CONFIG"

    jq -n \
        --argjson windows "$windows" \
        --argjson agoSec "$ago" \
        --argjson refused "$refused" \
        --arg detail "$( [[ "$refused" == true ]] && printf '%s' "${message#session-save: }" )" \
        --argjson captured "$captured" \
        --arg lastSave "$when" \
        --arg timer "$timer" \
        --argjson pluginEnabled "$plugin_on" \
        --arg session "$toml" \
        --argjson fallback "$fallback" \
        --argjson notes "$notes" \
        --argjson workspaces "${workspaces:-0}" \
        --argjson intervalSec "$(config_get saveIntervalSec "$DEFAULT_SAVE_INTERVAL" "$cfg_raw")" \
        --argjson restoreOnLogin "$(config_get restoreOnLogin "$DEFAULT_RESTORE_ON_LOGIN" "$cfg_raw")" \
        --argjson browserRepair "$(config_get browserRepair "$DEFAULT_BROWSER_REPAIR" "$cfg_raw")" \
        --argjson browserRepairChrome "$(config_get browserRepairChrome "$DEFAULT_BROWSER_REPAIR_CHROME" "$cfg_raw")" \
        --argjson appRestoreGhostty "$(config_get appRestoreGhostty "$DEFAULT_APP_RESTORE_GHOSTTY" "$cfg_raw")" \
        --argjson chromeInstalled "$chrome_installed" \
        --argjson chromeCaptured "$chrome_captured" \
        --argjson ghosttyInstalled "$ghostty_installed" \
        --argjson ghosttyCaptured "$ghostty_captured" \
        '{windows:$windows, workspaces:$workspaces, agoSec:$agoSec,
          refused:$refused, detail:$detail,
          captured:$captured, lastSave:$lastSave, timer:$timer,
          pluginEnabled:$pluginEnabled,
          intervalSec:$intervalSec, restoreOnLogin:$restoreOnLogin,
          browserRepair:$browserRepair, browserRepairChrome:$browserRepairChrome,
          appRestoreGhostty:$appRestoreGhostty,
          appAvailability:{googleChrome:{installed:$chromeInstalled,captured:$chromeCaptured},
                            ghostty:{installed:$ghosttyInstalled,captured:$ghosttyCaptured}},
          session:$session, usingFallback:$fallback, notes:$notes}'
}

cmd_layout() {
    local name="${1:-last}"
    python3 "$LIB/layout.py" "$SESSION_DIR" "$name"
}

cmd_list() {
    python3 "$LIB/history.py" list "$SESSION_DIR" "$@"
}

cmd_status() {
    local json=0 name=last
    for a in "$@"; do
        case "$a" in
            --json) json=1 ;;
            *) name="$a" ;;
        esac
    done

    if (( json )); then status_json "$name"; return; fi

    local s; s="$(status_json "$name")"
    local windows ago refused detail timer
    windows="$(jq -r .windows <<<"$s")"
    ago="$(jq -r .agoSec <<<"$s")"
    refused="$(jq -r .refused <<<"$s")"
    detail="$(jq -r .detail <<<"$s")"
    timer="$(jq -r .timer <<<"$s")"

    if (( ago < 0 )); then
        say "no session saved yet"
    else
        local human
        if   (( ago < 60 ));   then human="just now"
        elif (( ago < 3600 )); then human="$((ago/60)) min ago"
        else                        human="$((ago/3600)) h ago"
        fi
        say "$windows window(s) captured, $human"
    fi
    [[ "$(jq -r .usingFallback <<<"$s")" != "true" ]] || \
        err "the current session is not usable; the restore would use the previous generation"
    [[ "$timer" == active ]] || err "snapshot timer is not running (omasession install)"
    [[ "$(jq -r .pluginEnabled <<<"$s")" == true ]] || \
        err "the plugin is not enabled in omarchy-shell -- automatic save and login restore are paused"
    [[ "$refused" == false ]] || err "last save refused -- session preserved: $detail"
    jq -r '.captured[]? | "  ws\(.ws)  \(.cls)  \(.title)"' <<<"$s"
}

# ── resolve ──────────────────────────────────────────────────────────────────
# A resolver that is wrong looks exactly like an application that failed to
# open. The path taken has to be inspectable before it is trusted, so this is a
# first-class command and not a debug flag (docs/plans/003).
cmd_resolve() {
    hypr_env || die "no Hyprland instance"
    local json=0
    [[ "${1:-}" == "--json" ]] && json=1

    # As duas metades do pipeline com o próprio timeout -- achado da revisão
    # de segurança do marketplace (issue #6243, retorno do HANCORE-linux):
    # `timeout` só na primeira metade limita quando o hyprctl trava, não
    # quando o consumidor (resolve_cli.py, que por sua vez pode chamar tmux
    # por janela) trava.
    local out
    out="$(timeout --kill-after=5 15 hyprctl clients -j \
        | timeout --kill-after=5 30 python3 "$LIB/resolve_cli.py")" || die "resolve failed"
    if (( json )); then printf '%s\n' "$out"; return; fi

    jq -r '.[] | "  \(.via | . + (" " * (10 - length)))  \(.class)"
             + (if .ambiguous then "   (ambiguous: \(.ambiguous | length) other .desktop entry claims this class)" else "" end)' <<<"$out"
    local total resolved
    total="$(jq 'length' <<<"$out")"
    resolved="$(jq '[.[] | select(.argv != null)] | length' <<<"$out")"
    say "$resolved/$total resolved"
    jq -r '.[] | select(.argv == null) | "  ! \(.class): no command found"' <<<"$out"
}

# ── install ──────────────────────────────────────────────────────────────────
# write_units sets UNITS_CHANGED=1 when it had to rewrite either file. Files
# already holding the right content are left alone, so the service's
# `install --if-needed` on every shell start costs no daemon-reload.
UNITS_CHANGED=0
write_units() {
    mkdir -p "$UNIT_DIR"
    local interval; interval="$(config_get saveIntervalSec "$DEFAULT_SAVE_INTERVAL")"
    local service_unit timer_unit

    # Anchored on default.target, not graphical-session.target. The obvious
    # choice was wrong, and only a real reboot caught it: on this lab's Omarchy
    # 4 (SDDM autologin -> /usr/bin/start-hyprland -> Hyprland, no UWSM session
    # unit in between), graphical-session.target is a loaded but permanently
    # inactive definition -- nothing ever starts it, so a timer WantedBy=it
    # never comes back after a reboot even though `systemctl --user
    # is-enabled` still says "enabled". Measured: after a spontaneous VM
    # restart, autostart.lua's `restore --if-enabled` ran (confirmed in the
    # journal) and windows came back, but the snapshot timer stayed inactive
    # the whole time -- silently. default.target is the one target this host
    # actually reaches for a graphical login (confirmed active in the same
    # session), and every other login manager reaches it too, since it is
    # where systemd itself lands any user session.
    #
    # The cost of anchoring here instead of a graphical-session target: the
    # timer also runs for a plain SSH login with no Hyprland at all. That is
    # harmless by construction, not by luck -- session-save.sh's own guard
    # exits 3 ("cannot read hyprctl clients") without touching anything when
    # there is no compositor to read, and 3 is already in SuccessExitStatus
    # below.
    #
    # ConditionPathExists on both units: after `omarchy plugin remove` deletes
    # the CLI, the timer is skipped at the next login instead of failing every
    # interval. While the CLI is there, `save --if-enabled` does nothing for a
    # disabled plugin.
    service_unit="$(cat <<UNIT
[Unit]
Description=OmaSession session snapshot
ConditionPathExists=$SELF/bin/omasession

[Service]
Type=oneshot
ExecStart=$SELF/bin/omasession save --if-enabled
# The guard reports 3 when it refuses and 4 when another save holds the lock.
# Both are correct outcomes, not failures: without this systemd marks the unit
# failed and the user is told something broke when nothing did.
SuccessExitStatus=3 4
UNIT
)"
    timer_unit="$(cat <<UNIT
[Unit]
Description=OmaSession session snapshot
ConditionPathExists=$SELF/bin/omasession

[Timer]
OnActiveSec=${interval}s
OnUnitActiveSec=${interval}s
AccuracySec=1s

[Install]
WantedBy=default.target
UNIT
)"
    local name content
    for name in service timer; do
        if [[ "$name" == service ]]; then content="$service_unit"; else content="$timer_unit"; fi
        [[ "$(cat "$UNIT_DIR/omasession-snapshot.$name" 2>/dev/null)" == "$content" ]] && continue
        printf '%s\n' "$content" > "$UNIT_DIR/omasession-snapshot.$name"
        UNITS_CHANGED=1
    done
    (( UNITS_CHANGED )) && say "units written to $UNIT_DIR (every ${interval}s)"
    return 0
}

# The line checks that the CLI is still there before registering the restore,
# so a plugin removed without `uninstall` leaves an inert line, not a failed
# command at every login. One line, so remove_login_restore finds it.
autostart_line() { # autostart_line [plugin-dir]
    local cli="${1:-$SELF}/bin/omasession"
    printf 'do local f = io.open("%s") if f then f:close() o.launch_on_start("%s restore --if-enabled") end end' \
        "$cli" "$cli"
}

# Um unico backup, tirado antes da primeira modificacao e nunca sobrescrito.
# Marcador: toda edição nossa no autostart.lua carrega um destes, porque o
# desfazer tem de ser cirúrgico -- restaurar o arquivo inteiro do backup apaga
# o que o usuário adicionou DEPOIS do install. Medido na revisão -- install, o
# usuário acrescenta um app, uninstall, e o app dele some.
MARK_LOGIN="-- OmaSession: reopen the last session at login"

# Marcador de uma versão anterior deste script (antes de 13bcaca), que
# desarmava o autostart do hyprresume no install porque os dois escreviam os
# mesmos arquivos. Não competimos mais -- capturamos por conta própria, em
# diretório separado -- então o install de hoje não desarma nada. Mas quem
# instalou aquela versão tem essa linha comentada no autostart.lua até hoje, e
# sem desfazê-la aqui o uninstall nunca a alcança: achado da revisão, "uninstall
# anuncia sucesso e a alteração legada fica pra trás".
LEGACY_MARK_DISARM="-- omasession: disarmed, see docs/DESIGN.md §2 -- "

rearm_legacy_hyprresume() {
    local content rc
    safe_read_exact_into content "$AUTOSTART_DIR" "$AUTOSTART_NAME" && rc=0 || rc=$?
    (( rc == 0 || rc == 3 )) || safe_read_die "$rc" "$AUTOSTART"
    (( rc == 3 )) && return 0
    grep -qF -- "$LEGACY_MARK_DISARM" <<<"$content" || return 0
    # Monta antes de publicar, mesma forma dos outros 5 pontos equivalentes
    # -- achado omasession-15: este era o único que ainda fazia pipe direto
    # pro safe_write. sed com padrão fixo não falha em texto arbitrário, então
    # o risco real de publicar algo incompleto aqui sempre foi baixo; fechado
    # mesmo assim, por consistência de forma, não por um caso reproduzido.
    local transformed
    transformed="$(sed "s|^${LEGACY_MARK_DISARM}||" <<<"$content")" || die "could not re-arm $AUTOSTART"
    printf '%s\n' "$transformed" | safe_write "$AUTOSTART_DIR" "$AUTOSTART_NAME" 644
    say "hyprresume re-armed in autostart.lua (leftover from an older install)"
}

backup_autostart() {
    local content rc
    safe_read_exact_into content "$AUTOSTART_DIR" "$AUTOSTART_NAME" && rc=0 || rc=$?
    (( rc == 0 || rc == 3 )) || safe_read_die "$rc" "$AUTOSTART"
    (( rc == 3 )) && return 0
    # Preservado para recuperação manual, nunca aplicado automaticamente.
    # Checa EXISTÊNCIA do backup, não conteúdo -- achado das rodadas 14/15:
    # tratar um backup vazio como "não existe" o sobrescreveria.
    local bak_rc
    safe_read "$AUTOSTART_DIR" "$AUTOSTART_NAME.omasession.bak" >/dev/null && bak_rc=0 || bak_rc=$?
    if (( bak_rc == 0 )); then
        return 0   # backup já existe -- nunca sobrescrever
    elif (( bak_rc != 3 )); then
        safe_read_die "$bak_rc" "$AUTOSTART.omasession.bak"
    fi
    safe_copy "$AUTOSTART_DIR" "$AUTOSTART_NAME" "$AUTOSTART_NAME.omasession.bak"
}

add_login_restore() {
    local content rc
    safe_read_exact_into content "$AUTOSTART_DIR" "$AUTOSTART_NAME" && rc=0 || rc=$?
    (( rc == 0 || rc == 3 )) || safe_read_die "$rc" "$AUTOSTART"
    (( rc == 3 )) && { err "no $AUTOSTART -- skipping login restore"; return; }
    if grep -qF "omasession restore" <<<"$content"; then
        guard_login_restore "$content"
        return
    fi
    backup_autostart
    # printf '%s' sem \n -- $content já carrega a newline final que o arquivo
    # original tinha, preservada por safe_read_exact_into; um \n sintético
    # aqui duplicaria a quebra de linha a cada install (achado das rodadas
    # 14/15: o round-trip install/uninstall parou de devolver o arquivo
    # idêntico). A PRIMEIRA versão de safe_read_exact não preservava de
    # verdade -- protegia a newline só dentro de si mesma, e a atribuição
    # `content="$(safe_read_exact ...)"` comia de novo, um nível acima
    # (achado omasession-16 rev-2, medido com od -c: a linha em branco
    # separadora que este comentário promete estava sumindo). Corrigido
    # trocando por safe_read_exact_into, que escreve na variável do
    # chamador via `printf -v` em vez de por stdout+`$(...)` -- sem essa
    # segunda captura, não sobra uma segunda camada pra proteger contra.
    { printf '%s' "$content"; printf '\n%s\n%s\n' "$MARK_LOGIN" "$(autostart_line)"; } \
        | safe_write "$AUTOSTART_DIR" "$AUTOSTART_NAME" 644
    say "login restore added to autostart.lua"
}

# A line written by 0.5.0 or earlier registers the restore without checking
# that the CLI exists. Guard it in place, keeping the path it already names:
# that path may be a development checkout on purpose.
OLD_LOGIN_LINE='^o\.launch_on_start\("([^"]*)/bin/omasession restore --if-enabled"\)$'
guard_login_restore() { # guard_login_restore <autostart content>
    local content="$1" line dir guarded
    line="$(grep -E -m1 "$OLD_LOGIN_LINE" <<<"$content")" || {
        say "login restore already in autostart.lua"
        return 0
    }
    [[ "$line" =~ $OLD_LOGIN_LINE ]] || return 0
    dir="${BASH_REMATCH[1]}"
    guarded="$(autostart_line "$dir")"
    local transformed
    transformed="$(printf '%s' "$content" \
        | OLD="$line" NEW="$guarded" awk '$0 == ENVIRON["OLD"] { print ENVIRON["NEW"]; next } { print }' \
        || exit "$?"
        printf X)" || die "could not update $AUTOSTART"
    transformed="${transformed%X}"
    # awk ends the last line with a newline even when the file did not.
    [[ "$content" == *$'\n' ]] || transformed="${transformed%$'\n'}"
    printf '%s' "$transformed" | safe_write "$AUTOSTART_DIR" "$AUTOSTART_NAME" 644
    say "login restore in autostart.lua now checks that the CLI exists"
}

remove_login_restore() {
    local content rc
    safe_read_exact_into content "$AUTOSTART_DIR" "$AUTOSTART_NAME" && rc=0 || rc=$?
    (( rc == 0 || rc == 3 )) || safe_read_die "$rc" "$AUTOSTART"
    (( rc == 3 )) && return 0
    grep -qF "omasession restore" <<<"$content" || return 0
    # Remove a linha marcada e a nossa logo abaixo, e nada mais.
    # Segura uma linha em branco antes de imprimir: o install insere uma antes
    # do marcador, e deixá-la para trás faz o ciclo install/uninstall não
    # devolver o arquivo idêntico -- o que estraga a única checagem barata de
    # que o desfazer está completo. Testado byte a byte pro caso real (arquivo
    # terminado numa única newline, o que install/safe_read_exact preservam
    # corretamente); um arquivo já editado à mão com VÁRIAS linhas em branco
    # seguidas no final ainda perde as extras aqui -- o `held`/`heldline`
    # abaixo só carrega uma de cada vez, comportamento anterior a esta rodada,
    # não uma regressão dela, e não corrigido por ser um caso raro e por não
    # afetar a validade do arquivo.
    local new_content
    new_content="$(awk -v mark="$MARK_LOGIN" '
        $0 == mark            { held = 0; skip = 1; next }
        skip && /omasession restore/ { skip = 0; next }
        /^[[:space:]]*$/      { if (held) print heldline; heldline = $0; held = 1; next }
                              { if (held) { print heldline; held = 0 } skip = 0; print }
        END                   { if (held) print heldline }
    ' <<<"$content")"
    printf '%s\n' "$new_content" | safe_write "$AUTOSTART_DIR" "$AUTOSTART_NAME" 644
    if grep -qF "omasession restore" <<<"$new_content"; then
        err "an omasession line in autostart.lua was not written by install and was left alone"
    else
        say "login restore removed from autostart.lua"
    fi
}

# O diretório fixo de antes de 13bcaca -- não o $SESSION_DIR de hoje, que
# pode até ser o mesmo se OMASESSION_SESSION_DIR estiver setado pra lá, mas o
# caminho onde sessões de uma instalação anterior objetivamente estariam é
# sempre este, independente de qualquer override atual.
LEGACY_SESSION_DIR="$HOME/.local/share/hyprresume/sessions"

# "Completa" é a pergunta certa, não "existe": achado da rodada 6 -- checar só
# o toml deixava uma migração interrompida ENTRE os dois renames (toml já no
# nome final, sidecar ainda não) permanentemente pela metade, porque uma
# tentativa seguinte via o toml, achava que já tinha migrado, e desistia sem
# nunca copiar o sidecar que faltava. Ausência de sidecar NA ORIGEM (uma
# sessão salva pelo hyprresume puro, antes do sidecar existir) não conta
# contra completude -- não há o que copiar.
_legacy_migration_complete() { # _legacy_migration_complete <name> <sidecar-de-origem>
    [[ -f "$SESSION_DIR/$1.toml" ]] || return 1
    [[ -f "$2" ]] || return 0
    [[ -f "$SESSION_DIR/$1.titles.json" ]]
}

migrate_legacy_session() { # migrate_legacy_session [--new-only]
    # --new-only (every shell start, through `install --if-needed`) only brings
    # over names this machine has no session for yet. Finishing a half-copied
    # pair is left to a manual install: on a session of our own that lost its
    # sidecar, it would put the older legacy toml over the current one.
    local new_only=0
    [[ "${1:-}" == "--new-only" ]] && new_only=1
    [[ -d "$LEGACY_SESSION_DIR" ]] || return 0
    # Temporários de uma migração anterior morta por SIGKILL no meio do cp --
    # achado da rodada 6. Seguro varrer sem checar idade nem /proc: só esta
    # função os cria, e cada cp/mv abaixo usa um nome próprio recém-gerado,
    # nunca um destes.
    rm -f "$SESSION_DIR"/.migrate.*.?????? 2>/dev/null || true
    local toml name sidecar tmp_toml tmp_side
    # Toda sessão nomeada no diretório antigo, não só "last": a CLI sempre
    # aceitou `save [name]`/`restore [name]`, e a primeira versão desta
    # migração só olhava "last" -- achado da rodada 5. `*.prev` é pulado aqui
    # porque não é uma sessão própria, é a geração anterior de uma que já
    # está no laço; copiada junto, mais abaixo.
    for toml in "$LEGACY_SESSION_DIR"/*.toml; do
        [[ -e "$toml" ]] || continue
        name="$(basename "$toml" .toml)"
        case "$name" in omasession.*|*.prev) continue ;; esac
        sidecar="$LEGACY_SESSION_DIR/$name.titles.json"
        (( new_only )) && [[ -e "$SESSION_DIR/$name.toml" ]] && continue
        # Nunca sobrescreve uma sessão que o novo capturador já salvou por
        # completo, seja "last" ou um nome próprio -- achado da rodada 4.
        _legacy_migration_complete "$name" "$sidecar" && continue

        # O mesmo lock que save/restore respeitam para este nome: achado da
        # rodada 5, sem isto uma migração correndo ao lado de um save do
        # MESMO nome (raro, mas possível logo depois de um install cujo timer
        # já dispara) publica um por cima do outro sem se ver.
        exec 9>"$SESSION_DIR/.$name.lock"
        if ! flock -n 9; then
            err "skipping migration of '$name' -- a save is running"
            exec 9>&-
            continue
        fi
        # Reconfere JÁ com o lock: achado da rodada 6 -- a checagem acima
        # roda antes de travar, e um save do mesmo nome pode publicar bem
        # nessa janela. Sem reconferir aqui, a migração sobrescreveria uma
        # sessão nova com a legada, o oposto do que a checagem existe pra
        # evitar.
        if _legacy_migration_complete "$name" "$sidecar" \
            || { (( new_only )) && [[ -e "$SESSION_DIR/$name.toml" ]]; }; then
            exec 9>&-
            continue
        fi

        # Encena com nomes temporários e só troca pro nome final por rename:
        # achado da rodada 5, copiar direto pro nome final e ser interrompido
        # no meio deixava um par pela metade que a checagem de existência via
        # como "já migrado". Agora a checagem é de completude (acima), então
        # mesmo uma interrupção entre os dois renames abaixo se corrige numa
        # tentativa seguinte -- mas encenar continua sendo o que evita
        # publicar um toml a meio caminho de copiar.
        tmp_toml="$(mktemp "$SESSION_DIR/.migrate.$name.XXXXXX")"
        if ! cp -p "$toml" "$tmp_toml" 2>/dev/null; then
            err "could not migrate '$name' from $LEGACY_SESSION_DIR -- copying the session failed"
            rm -f "$tmp_toml"
            exec 9>&-
            continue
        fi
        mv -f "$tmp_toml" "$SESSION_DIR/$name.toml"

        if [[ -f "$sidecar" ]]; then
            tmp_side="$(mktemp "$SESSION_DIR/.migrate.$name.XXXXXX")"
            if cp -p "$sidecar" "$tmp_side" 2>/dev/null; then
                mv -f "$tmp_side" "$SESSION_DIR/$name.titles.json"
                say "migrated '$name' from $LEGACY_SESSION_DIR (left untouched there)"
            else
                rm -f "$tmp_side"
                err "migrated '$name' but its title sidecar failed to copy -- browser windows in it won't re-match their workspace; a later install will retry"
            fi
        else
            # Sessão salva pelo hyprresume puro, antes do sidecar existir --
            # achado da rodada 6: a versão anterior pulava em silêncio.
            say "migrated '$name' from $LEGACY_SESSION_DIR without a title sidecar (an old save, from before this had one)"
        fi

        if [[ -f "$LEGACY_SESSION_DIR/$name.prev.toml" && -f "$LEGACY_SESSION_DIR/$name.prev.titles.json" \
           && ! -f "$SESSION_DIR/$name.prev.toml" ]]; then
            cp -p "$LEGACY_SESSION_DIR/$name.prev.toml" "$SESSION_DIR/$name.prev.toml" 2>/dev/null || true
            cp -p "$LEGACY_SESSION_DIR/$name.prev.titles.json" "$SESSION_DIR/$name.prev.titles.json" 2>/dev/null || true
        fi
        exec 9>&-
    done
}

# ── setup state ──────────────────────────────────────────────────────────────
# What `install --if-needed` must respect and cannot see in the files
# themselves: that `uninstall` was run (the plugin's service would otherwise
# set everything up again at the next shell start), and that the login line
# and the timer were set up once (so a line the user deleted stays deleted,
# and a timer the user disabled stays off).
#
# The uninstall is recorded against this plugin directory (device and inode):
# removing the plugin and adding it again clones a new directory, which sets
# itself up like any first install, while `omarchy plugin update` keeps the
# directory and so keeps the refusal.
# The birth time keeps a filesystem that reuses a freed inode from handing the
# refusal on to a new clone.
plugin_dir_id() { stat -L -c '%d:%i:%W' "$SELF" 2>/dev/null || printf 'unknown'; }

setup_state_raw() {
    local raw
    raw="$(safe_read "$STATE_DIR" setup.json)" || raw=""
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"$raw" && printf '%s' "$raw" || printf '{}'
}

setup_declined() {
    jq -e --arg id "$(plugin_dir_id)" '.declinedFor == $id' >/dev/null 2>&1 <<<"$(setup_state_raw)"
}

setup_state_present() { safe_read "$STATE_DIR" setup.json >/dev/null; }

setup_state_get() { # setup_state_get loginLine|timer -> true|false
    jq -r --arg k "$1" 'if .[$k] == true then "true" else "false" end' <<<"$(setup_state_raw)"
}

setup_state_set() { # setup_state_set <declined> <loginLine> <timer>, each true|false
    local raw doc declined_for=""
    raw="$(setup_state_raw)"
    [[ "$1" == true ]] && declined_for="$(plugin_dir_id)"
    doc="$(jq -n --arg d "$declined_for" --argjson l "$2" --argjson t "$3" \
        '{loginLine:$l, timer:$t} + (if $d == "" then {} else {declinedFor:$d} end)')" \
        || die "could not build setup state"
    [[ "$(jq -cS . <<<"$raw")" == "$(jq -cS . <<<"$doc")" ]] && return 0
    printf '%s\n' "$doc" | safe_write "$STATE_DIR" setup.json
}

login_line_present() {
    grep -qF "omasession restore" <<<"$(safe_read "$AUTOSTART_DIR" "$AUTOSTART_NAME")"
}

timer_enabled() { systemctl --user is-enabled --quiet omasession-snapshot.timer 2>/dev/null; }

# 0.5.0 kept no setup.json, so the first `install --if-needed` after the
# upgrade reads what that version left. Its install backed up autostart.lua
# before adding the login line, and its uninstall kept that backup: a backup
# with no line means the line was taken out, by uninstall when the units went
# with it, by hand otherwise. Units on disk with the timer disabled mean the
# user turned it off (or a 0.5.0 install failed to enable it; nothing on disk
# tells the two apart, and `omasession install` fixes the second).
#
# A plugin directory created after the backup is a plugin removed and added
# again, which sets itself up like a first install. Without birth times to
# compare, the backup counts. Returns 1 when that was an uninstall.
infer_setup_state() {
    local bak=0 line=false timer=false dir_born bak_born
    safe_read "$AUTOSTART_DIR" "$AUTOSTART_NAME.omasession.bak" >/dev/null && bak=1
    if (( bak )); then
        dir_born="$(stat -L -c '%.9W' "$SELF" 2>/dev/null)" || dir_born=0
        bak_born="$(stat -c '%.9W' "$AUTOSTART.omasession.bak" 2>/dev/null)" || bak_born=0
        if [[ "$dir_born" =~ ^[1-9][0-9]*\.[0-9]{9}$ && "$bak_born" =~ ^[1-9][0-9]*\.[0-9]{9}$ ]] \
            && (( 10#${dir_born/./} > 10#${bak_born/./} )); then
            bak=0
        fi
    fi
    if (( bak )) && ! login_line_present; then
        if [[ ! -e "$UNIT_DIR/omasession-snapshot.timer" ]]; then
            setup_state_set true false false
            say "setup was undone by 'omasession uninstall' -- run 'omasession install' to set it up again"
            return 1
        fi
        line=true
    fi
    [[ -e "$UNIT_DIR/omasession-snapshot.timer" ]] && ! timer_enabled && timer=true
    setup_state_set false "$line" "$timer"
}

# Setup and its undo hold one lock. The plugin's service runs `install
# --if-needed` on every shell start, and a second shell start (or a manual
# install) during it would otherwise read and rewrite autostart.lua at the
# same time. Same re-exec as `config set`: the descriptor is opened by
# safe_fs, never by a bash redirect.
setup_lock() { # setup_lock <command> [args...]
    if ! : 2>/dev/null >&7; then
        exec /usr/bin/python3 "$SAFE_FS" exec-with-lock \
            "$STATE_DIR" ".setup.lock" 7 -- bash "${BASH_SOURCE[0]}" "$@"
    fi
    flock 7
}

cmd_install() {
    local if_needed=0
    [[ "${1:-}" == "--if-needed" ]] && if_needed=1
    command -v jq >/dev/null || die "jq is required"
    command -v python3 >/dev/null || die "python3 is required"
    setup_lock install "$@"

    # `uninstall` asked for none of this. Only an explicit install undoes that.
    if (( if_needed )) && setup_declined; then
        say "setup was undone by 'omasession uninstall' -- run 'omasession install' to set it up again"
        return 0
    fi
    if (( if_needed )) && ! setup_state_present; then
        infer_setup_state || return 0
    fi

    mkdir -p "$SESSION_DIR"
    if (( if_needed )); then migrate_legacy_session --new-only; else migrate_legacy_session; fi
    # rc, não só string vazia -- achado omasession-16 (rev-1): um config.json
    # de verdade, maior que o teto de 8 MiB, também lê como string vazia
    # (rc=1, recusado -- não rc=3, ausente), e a versão anterior escrevia os
    # defaults por cima dele do mesmo jeito que faria numa instalação nova,
    # apagando uma configuração real por engano.
    local cfg_rc
    safe_read "$CONFIG_DIR" config.json >/dev/null && cfg_rc=0 || cfg_rc=$?
    (( cfg_rc == 0 || cfg_rc == 3 )) || safe_read_die "$cfg_rc" "$CONFIG"
    if (( cfg_rc == 3 )); then
        # Monta antes de publicar, mesma razão do cmd_config/cmd_save -- acha-
        # do da revisão (omasession-15): esta era a mesma forma exata (jq -n
        # ... | safe_write) que já tinha sido corrigida nos outros dois
        # pontos e ficou de fora por inconsistência, não por avaliação.
        local defaults
        defaults="$(jq -n --argjson i "$DEFAULT_SAVE_INTERVAL" \
              --argjson r "$DEFAULT_RESTORE_ON_LOGIN" \
              --argjson b "$DEFAULT_BROWSER_RESTORE" \
              --argjson br "$DEFAULT_BROWSER_REPAIR" \
              --argjson brc "$DEFAULT_BROWSER_REPAIR_CHROME" \
              --argjson agh "$DEFAULT_APP_RESTORE_GHOSTTY" \
              '{saveIntervalSec:$i, restoreOnLogin:$r, browserRestore:$b, browserRepair:$br, browserRepairChrome:$brc, appRestoreGhostty:$agh}')" \
            || die "could not build default config"
        printf '%s\n' "$defaults" | safe_write "$CONFIG_DIR" config.json
        say "config written to $CONFIG"
    fi

    write_units
    # Once the timer has been set up, --if-needed leaves it alone while the
    # user keeps it disabled: new units are loaded, not turned back on.
    local status=0 had_timer enabled=0 timer_on=false
    had_timer="$(setup_state_get timer)"
    timer_enabled && enabled=1
    if (( ! if_needed )) || [[ "$had_timer" != true ]] \
        || { (( enabled )) && { (( UNITS_CHANGED )) \
             || ! systemctl --user is-active --quiet omasession-snapshot.timer 2>/dev/null; }; }; then
        # Disable before enabling again: `enable` never removes a symlink left
        # by an older [Install] section, so upgrading from a version anchored
        # on a different target (graphical-session.target -- see write_units
        # for why that one turned out wrong) would leave a stale .wants/
        # symlink, active by whichever target happens to start. `disable`
        # removes every symlink to the unit, whatever the file now says.
        systemctl --user disable --now omasession-snapshot.timer >/dev/null 2>&1 || true
        systemctl --user daemon-reload >/dev/null 2>&1 || true
        if systemctl --user enable --now omasession-snapshot.timer >/dev/null 2>&1; then
            say "snapshot timer enabled"
            timer_on=true
        else
            err "could not enable the timer (no systemd user session?)"
            status=1
        fi
    elif (( ! enabled )); then
        (( UNITS_CHANGED )) && { systemctl --user daemon-reload >/dev/null 2>&1 || true; }
        say "snapshot timer was disabled in systemd -- leaving it off ('omasession install' turns it back on)"
    fi
    # A failed enable after the disable above is not the user's choice.
    [[ "$had_timer" == true ]] && (( status == 0 )) && timer_on=true

    # A linha entra sempre; ligar e desligar é com o config, que o painel
    # escreve e que `restore --if-enabled` consulta no login. Só não volta,
    # no --if-needed, quando o usuário a apagou depois de ela ter entrado.
    local had_line; had_line="$(setup_state_get loginLine)"
    if (( if_needed )) && [[ "$had_line" == true ]] && ! login_line_present; then
        say "login restore was removed from autostart.lua -- leaving it out ('omasession install' puts it back)"
    else
        add_login_restore
    fi
    local has_line=false
    login_line_present && has_line=true
    [[ "$had_line" == true ]] && has_line=true
    setup_state_set false "$has_line" "$timer_on"

    if (( if_needed )); then
        return "$status"
    fi

    # browser-setup --list-paths is the one place that knows all five vendor
    # directories -- found by review (omasession-7): this check used to hardcode
    # just 2 of them, so a Brave/Vivaldi/Edge-only machine that HAD run
    # browser-setup still got told it hadn't. `listed` is separate from
    # `policy_seen` -- found by review (omasession-8): a broken/missing
    # browser-setup makes the loop read zero lines, which used to look
    # identical to "checked, found nothing" and stayed silent instead of
    # flagging that the check itself failed.
    local policy_seen=0 listed=0 pf
    while IFS= read -r pf; do
        listed=1
        [[ -f "$pf" ]] && policy_seen=1
    done < <("$SELF/bin/browser-setup" --list-paths)
    # Só avisa se algum navegador Chromium-family estiver de fato instalado
    # -- achado da revisão (omasession-20, rev-2): sem essa guarda, um
    # usuário só-Firefox recebia o mesmo aviso e, seguindo-o, escrevia uma
    # política pra um navegador que não existe na máquina (inofensivo, mas
    # inútil, e o plugin passava a reportar a política como "instalada"
    # pra um navegador que nunca vai lê-la). A checagem antiga por
    # navegador saiu junto com o writer que ela existia pra decidir; esta é
    # só o que sobrou de útil dela.
    local chromium_family_present=0 bin
    for bin in google-chrome-stable chromium brave vivaldi-stable microsoft-edge-stable; do
        command -v "$bin" >/dev/null 2>&1 && { chromium_family_present=1; break; }
    done
    if (( ! listed )); then
        err "could not check browser policy (browser-setup --list-paths failed)"
    elif (( ! policy_seen && chromium_family_present )); then
        err "browser policy not installed -- see the README's browser policy section for the one-time manual command"
    fi
    # Silencioso até a rodada 5: quem atualizou de uma versão que desarmava o
    # hyprresume ficava com a linha comentada enquanto o OmaSession estivesse
    # instalado, sem nenhuma indicação de que essa alteração ainda existe ou
    # de que este install já não a faz mais.
    if grep -qF -- "$LEGACY_MARK_DISARM" <<<"$(safe_read "$AUTOSTART_DIR" "$AUTOSTART_NAME")"; then
        say "note: hyprresume is still disarmed in autostart.lua from an older install -- this version no longer does that, but won't undo it either; 'omasession uninstall' will"
    fi
    say "installed"
}

cmd_uninstall() {
    setup_lock uninstall "$@"
    # Recorded first: the plugin's service must not set this up again.
    setup_state_set true false false
    systemctl --user disable --now omasession-snapshot.timer >/dev/null 2>&1 || true
    rm -f "$UNIT_DIR/omasession-snapshot.timer" "$UNIT_DIR/omasession-snapshot.service"
    systemctl --user daemon-reload 2>/dev/null || true
    # Desfaz só o que instalamos. Restaurar o backup inteiro descartaria tudo
    # que o usuário editou depois do install -- P0 da rodada 2.
    remove_login_restore
    rearm_legacy_hyprresume
    if [[ -n "$(safe_read "$AUTOSTART_DIR" "$AUTOSTART_NAME.omasession.bak")" ]]; then
        say "backup kept at $(basename "$AUTOSTART").omasession.bak (not applied)"
    fi
    # A política do navegador mora fora de qualquer diretório que este
    # comando (sem sudo) tem permissão de tocar, e não é mais escrita por
    # nenhum script deste plugin -- é um `sudo install`/`sudo rm` literal
    # que o próprio usuário roda, documentado no README (achado da revisão
    # de segurança do marketplace, issue #6243, HANCORE-linux: root nunca
    # deve carregar código deste checkout). Aqui só detecta e imprime o
    # comando de volta, nunca tenta escalar privilégio sozinho. A lista de
    # diretórios vem de browser-setup --list-paths (que continua sem
    # privilégio, só lista caminhos), não de uma segunda cópia aqui --
    # achado da revisão (omasession-7): duas cópias já tinham divergido
    # (esta tinha 5, o check do install acima só conhecia 2). `listed`
    # separado de `found` -- achado da revisão (omasession-8): um
    # browser-setup quebrado ou ausente fazia o loop ler zero linhas,
    # indistinguível de "chequei e não tem nada", deixando o aviso
    # desligado bem no caminho que ele existe pra cobrir.
    local found=0 listed=0 f present=()
    while IFS= read -r f; do
        listed=1
        [[ -f "$f" ]] && { found=$((found + 1)); present+=("$f"); }
    done < <("$SELF/bin/browser-setup" --list-paths)
    if (( ! listed )); then
        say "note: could not check for a leftover browser policy (browser-setup --list-paths failed) -- check /etc/*/policies/managed/omasession-no-promo.json by hand"
    elif (( found > 0 )); then
        say "note: $found browser-wide restore policy file(s) are still active system-wide -- to remove them:"
        for f in "${present[@]}"; do
            say "  sudo rm -f $f"
        done
    fi
    say "uninstalled -- saved sessions in $SESSION_DIR were left alone"
}

# ── config ───────────────────────────────────────────────────────────────────
# The one write path into config.json outside `install`. The panel is the
# reason this exists: DESIGN.md §6 keeps every write out of Panel.qml, so a
# toggle in the UI cannot poke the file itself -- it has to ask the CLI, same
# as save/restore. Writing straight from QML would also duplicate the typing
# rules below in a second language.
cmd_config() {
    local sub="${1:-}"
    case "$sub" in
        get)
            local key="${2:?usage: omasession config get <key>}"
            config_get "$key" ""
            ;;
        set)
            local key="${2:?usage: omasession config set <key> <value>}"
            local value="${3:?usage: omasession config set <key> <value>}"
            # Serialize the whole read/modify/publish transaction. safe_write
            # publishes each document atomically, but without this lock two
            # concurrent config writers can both read the same old document
            # and one silently overwrite the other's key.
            if ! : 2>/dev/null >&9; then
                exec /usr/bin/python3 "$SAFE_FS" exec-with-lock \
                    "$CONFIG_DIR" ".config.lock" 9 -- bash "${BASH_SOURCE[0]}" \
                    config set "$key" "$value"
            fi
            flock 9
            local current rc
            current="$(safe_read "$CONFIG_DIR" config.json)" && rc=0 || rc=$?
            (( rc == 0 || rc == 3 )) || safe_read_die "$rc" "$CONFIG"
            if (( rc == 3 )); then
                current='{}'
            else
                # Falhar cedo e com a causa certa -- achado da revisão
                # (omasession-15): sem isto, um config.json corrompido fazia
                # o merge do jq abaixo falhar e a mensagem culpava "$value",
                # que nunca teve nada de errado.
                jq -e . >/dev/null 2>&1 <<<"$current" \
                    || die "config.json does not parse -- fix or delete $CONFIG"
            fi
            # true/false/numbers stay bare JSON; anything else is a JSON string.
            # A key that does not already round-trip through jq is rejected
            # rather than written half-typed.
            local typed
            case "$value" in
                true|false|[0-9]*) typed="$value" ;;
                *) typed="$(jq -Rn --arg v "$value" '$v')" ;;
            esac
            # Monta o documento inteiro numa variável antes de publicar --
            # achado da revisão (omasession-14): `jq ... | safe_write ...`
            # direto deixa safe_write publicar o que quer que tenha chegado
            # no stdin, mesmo vazio, antes de o próprio bash notar que o jq
            # falhou (pipefail só reage DEPOIS que o pipe inteiro já correu).
            # Reproduzido: um config.json corrompido fazia jq falhar com
            # rc=5 e ainda assim sobrescrevia o arquivo com zero bytes.
            local updated
            updated="$(jq --arg k "$key" --argjson v "$typed" '.[$k] = $v' <<<"$current")" \
                || die "invalid config value"
            printf '%s\n' "$updated" | safe_write "$CONFIG_DIR" config.json
            say "$key = $value"
            ;;
        *) die "usage: omasession config get|set <key> [value]" ;;
    esac
}

usage() { sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
    save)      shift; cmd_save "$@" ;;
    restore)   shift; cmd_restore "$@" ;;
    restore-browser) shift; cmd_restore_browser "$@" ;;
    restore-app) shift; cmd_restore_app "$@" ;;
    status)    shift; cmd_status "$@" ;;
    list)      shift; cmd_list "$@" ;;
    layout)    shift; cmd_layout "$@" ;;
    resolve)   shift; cmd_resolve "$@" ;;
    install)   shift; cmd_install "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    config)    shift; cmd_config "$@" ;;
    -h|--help|help|"") usage ;;
    *) err "unknown command: $1"; usage; exit 1 ;;
esac
