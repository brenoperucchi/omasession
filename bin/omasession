#!/usr/bin/env bash
# OmaSession -- reopen the windows you had, where you had them.
#
#   omasession save [name]        capture the session (guarded)
#   omasession restore [name]     replay it into the compositor
#                                 (--if-enabled: só se restoreOnLogin estiver on)
#   omasession status [--json]    what was captured, when, and what is wrong
#   omasession resolve [--json]   which command each open window resolves to
#   omasession install            timer, login restore, browser policy
#   omasession uninstall          undo install
#   omasession config get <key>   read one config value (empty if unset)
#   omasession config set <key> <value>   persist one config value
#
# Everything heavy lives here rather than in Panel.qml: a crash inside
# quickshell takes down the bar, the dock and the menu at once, and restoring
# has to work when there is no shell at all (docs/DESIGN.md §6). The panel only
# reads `status --json` and calls back into this script.

set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="$SELF/lib"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omasession"
CONFIG="$CONFIG_DIR/config.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omasession"
SAVE_STATE="$STATE_DIR/last-save.json"
# Nosso diretório, não mais o do hyprresume -- ver lib/session-save.sh para o
# porquê da migração. Honra a mesma variável que ele, por consistência.
SESSION_DIR="${OMASESSION_SESSION_DIR:-$HOME/.local/share/omasession/sessions}"

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/autostart.lua"

toml_windows() {
    [[ -f "$1" ]] || { echo 0; return; }
    python3 - "$1" <<'PY' 2>/dev/null || echo 0
import sys, tomllib
with open(sys.argv[1], "rb") as fh:
    print(len(tomllib.load(fh).get("window", [])))
PY
}

say()  { printf 'omasession: %s\n' "$*"; }
err()  { printf 'omasession: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# ── configuration ────────────────────────────────────────────────────────────
# The manifest declares these under barWidget.schema, which is the quickshell
# preference store -- unreachable from a systemd timer or from a login-time
# restore, which are exactly the two places that need them. So the file below
# is the source of truth and the panel writes it; the manifest only supplies
# the defaults a fresh install starts from.
DEFAULT_SAVE_INTERVAL=30
DEFAULT_RESTORE_ON_LOGIN=true
DEFAULT_BROWSER_RESTORE=true

config_get() { # config_get <key> <default>
    [[ -f "$CONFIG" ]] || { printf '%s' "$2"; return; }
    local v
    # `// empty` trata false como ausente, então `restoreOnLogin: false` caía no
    # default `true` e o install adicionava a linha de login mesmo assim -- uma
    # opção que o usuário desligou e o programa ignorou em silêncio. `has` é o
    # que distingue chave ausente de valor falso.
    v="$(jq -r --arg k "$1" 'if has($k) and .[$k] != null then .[$k] else empty end' \
         "$CONFIG" 2>/dev/null)" || v=""
    [[ -n "$v" ]] && printf '%s' "$v" || printf '%s' "$2"
}

# ── hyprland ─────────────────────────────────────────────────────────────────
hypr_env() {
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
        export HYPRLAND_INSTANCE_SIGNATURE
    fi
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]
}

# ── save ─────────────────────────────────────────────────────────────────────
cmd_save() {
    local name="${1:-last}" out rc
    mkdir -p "$STATE_DIR"
    set +e
    out="$("$LIB/session-save.sh" "$name" 2>&1)"; rc=$?
    set -e
    printf '%s\n' "$out"

    # Record the outcome so `status` can report a refusal instead of leaving it
    # in the journal. A guard that protects the session silently looks exactly
    # like a guard that never ran.
    local windows; windows="$(toml_windows "$SESSION_DIR/$name.toml")"
    jq -n --arg when "$(date -u +%FT%TZ)" --argjson rc "$rc" \
          --arg message "$(printf '%s' "$out" | tail -1)" \
          --argjson windows "$windows" --arg name "$name" \
          '{when:$when, rc:$rc, message:$message, windows:$windows, name:$name}' \
        > "$SAVE_STATE.tmp" && mv -f "$SAVE_STATE.tmp" "$SAVE_STATE"
    return $rc
}

# ── restore ──────────────────────────────────────────────────────────────────
cmd_restore() {
    # --if-enabled é o que a linha do autostart.lua chama. A linha existe
    # sempre; quem decide é o config. Antes havia DUAS fontes de verdade -- o
    # `restoreOnLogin` do config e a presença da linha -- e o interruptor do
    # painel escrevia só a primeira, então desligá-lo não desligava nada. Uma
    # opção que o programa ignora é o defeito que este projeto acusa nos outros.
    if [[ "${1:-}" == "--if-enabled" ]]; then
        shift
        if [[ "$(config_get restoreOnLogin "$DEFAULT_RESTORE_ON_LOGIN")" == "false" ]]; then
            say "restore on login is off -- nothing to do"
            return 0
        fi
    fi
    local name="${1:-last}"
    hypr_env || die "no Hyprland instance -- nothing to restore into"
    [[ -f "$SESSION_DIR/$name.toml" ]] || die "no saved session at $SESSION_DIR/$name.toml"

    # O restore toma o MESMO lock que o save, e o segura ate o fim.
    #
    # Sem isto os dois correm: restaurando 6 janelas, se o timer dispara com 1
    # na tela, o guard ve count_old=6, count_screen=1, count_new=1 -- e as duas
    # regras deixam publicar, porque "a tela encolheu" e um encolhimento
    # legitimo do ponto de vista dele. O proprio fluxo recem-instalado
    # substituiria a sessao completa pela parcialmente restaurada. Achado da
    # rodada 2; o guard sozinho nao podia ver a diferenca, porque a informacao
    # que falta ("estamos no meio de um restore") nao esta na tela.
    #
    # `exec` abaixo troca este shell pelo replay, mas o descritor 9 sobrevive a
    # troca: o lock fica seguro pelo processo do replay e e liberado quando ele
    # termina, inclusive se ele morrer.
    exec 9>"$SESSION_DIR/.$name.lock"
    if ! flock -n 9; then
        die "a save is running -- refusing to restore on top of it"
    fi

    # browserRestore ainda nao e respeitado: replay.py nao le a opcao. Dizer
    # isso e melhor que exportar uma variavel que ninguem consome -- uma opcao
    # que finge funcionar e exatamente o defeito que este projeto existe para
    # combater.
    if [[ "$(config_get browserRestore "$DEFAULT_BROWSER_RESTORE")" == "false" ]]; then
        err "browserRestore=false ainda nao e respeitado; os browsers vao reabrir suas janelas"
    fi
    exec python3 "$LIB/replay.py" "$SESSION_DIR/$name.toml"
}

# ── status ───────────────────────────────────────────────────────────────────
# The JSON shape is the contract Panel.qml already renders against; keep the
# keys stable or the panel silently shows nothing.
status_json() {
    local name="${1:-last}"
    local toml="$SESSION_DIR/$name.toml" sidecar="$SESSION_DIR/$name.titles.json"

    # O que o RESTORE usaria, não o que está em last.toml. Um par rasgado manda
    # o replay para a geração anterior, e sem perguntar a ele o painel mostraria
    # uma sessão enquanto o botão restauraria outra.
    local effective side_used
    effective="$(python3 "$LIB/effective.py" "$toml" 2>/dev/null || echo '{}')"
    side_used="$(jq -r '.sidecar // ""' <<<"$effective")"
    local fallback; fallback="$(jq -r '.fallback // false' <<<"$effective")"
    local notes; notes="$(jq -c '.notes // []' <<<"$effective")"
    local windows; windows="$(jq -r '.windows // 0' <<<"$effective")"

    # The captured list carries what the panel needs to group and to be honest:
    # the workspace it belongs to, a name a person recognises, and whether the
    # resolver can actually bring it back. "Ready" is a claim; `resolvable` is
    # a claim we can support -- answered from the .desktop index, which needs no
    # live process, because the saved session describes windows already gone.
    local captured='[]'
    if [[ -n "$side_used" && -f "$side_used" ]]; then
        local toml_used="${side_used%.titles.json}.toml"
        captured="$(python3 "$LIB/captured.py" "$side_used" "$toml_used" 2>/dev/null || echo '[]')"
    fi

    workspaces="$(jq -c '[.[].ws] | unique | length' <<<"$captured" 2>/dev/null || echo 0)"

    # Age is measured from the session file, not from our own state file: the
    # question the user has is "how old is what would be restored", and only the
    # file that would be restored can answer it.
    local ago=-1 mtime
    if [[ -f "$toml" ]] && mtime="$(stat -c %Y "$toml" 2>/dev/null)"; then
        ago=$(( $(date +%s) - mtime ))
    fi

    local rc=0 message="" when=""
    if [[ -f "$SAVE_STATE" ]]; then
        rc="$(jq -r '.rc // 0' "$SAVE_STATE" 2>/dev/null || echo 0)"
        message="$(jq -r '.message // ""' "$SAVE_STATE" 2>/dev/null || echo "")"
        when="$(jq -r '.when // ""' "$SAVE_STATE" 2>/dev/null || echo "")"
    fi
    local refused=false
    [[ "$rc" == "3" ]] && refused=true

    local timer="inactive"
    systemctl --user is-active --quiet omasession-snapshot.timer 2>/dev/null && timer="active"

    jq -n \
        --argjson windows "$windows" \
        --argjson agoSec "$ago" \
        --argjson refused "$refused" \
        --arg detail "$( [[ "$refused" == true ]] && printf '%s' "${message#session-save: }" )" \
        --argjson captured "$captured" \
        --arg lastSave "$when" \
        --arg timer "$timer" \
        --arg session "$toml" \
        --argjson fallback "$fallback" \
        --argjson notes "$notes" \
        --argjson workspaces "${workspaces:-0}" \
        --argjson intervalSec "$(config_get saveIntervalSec "$DEFAULT_SAVE_INTERVAL")" \
        --argjson restoreOnLogin "$(config_get restoreOnLogin "$DEFAULT_RESTORE_ON_LOGIN")" \
        '{windows:$windows, workspaces:$workspaces, agoSec:$agoSec,
          refused:$refused, detail:$detail,
          captured:$captured, lastSave:$lastSave, timer:$timer,
          intervalSec:$intervalSec, restoreOnLogin:$restoreOnLogin,
          session:$session, usingFallback:$fallback, notes:$notes}'
}

cmd_status() {
    local json=0 name=last
    for a in "$@"; do
        case "$a" in
            --json) json=1 ;;
            *) name="$a" ;;
        esac
    done

    if (( json )); then status_json "$name"; return; fi

    local s; s="$(status_json "$name")"
    local windows ago refused detail timer
    windows="$(jq -r .windows <<<"$s")"
    ago="$(jq -r .agoSec <<<"$s")"
    refused="$(jq -r .refused <<<"$s")"
    detail="$(jq -r .detail <<<"$s")"
    timer="$(jq -r .timer <<<"$s")"

    if (( ago < 0 )); then
        say "no session saved yet"
    else
        local human
        if   (( ago < 60 ));   then human="just now"
        elif (( ago < 3600 )); then human="$((ago/60)) min ago"
        else                        human="$((ago/3600)) h ago"
        fi
        say "$windows window(s) captured, $human"
    fi
    [[ "$(jq -r .usingFallback <<<"$s")" != "true" ]] || \
        err "the current session is not usable; the restore would use the previous generation"
    [[ "$timer" == active ]] || err "snapshot timer is not running (omasession install)"
    [[ "$refused" == false ]] || err "last save refused -- session preserved: $detail"
    jq -r '.captured[]? | "  ws\(.ws)  \(.cls)  \(.title)"' <<<"$s"
}

# ── resolve ──────────────────────────────────────────────────────────────────
# A resolver that is wrong looks exactly like an application that failed to
# open. The path taken has to be inspectable before it is trusted, so this is a
# first-class command and not a debug flag (docs/plans/003).
cmd_resolve() {
    hypr_env || die "no Hyprland instance"
    local json=0
    [[ "${1:-}" == "--json" ]] && json=1

    local out
    out="$(hyprctl clients -j | python3 "$LIB/resolve_cli.py")" || die "resolve failed"
    if (( json )); then printf '%s\n' "$out"; return; fi

    jq -r '.[] | "  \(.via | . + (" " * (10 - length)))  \(.class)"
             + (if .ambiguous then "   (ambiguous: \(.ambiguous | length) other .desktop entry claims this class)" else "" end)' <<<"$out"
    local total resolved
    total="$(jq 'length' <<<"$out")"
    resolved="$(jq '[.[] | select(.argv != null)] | length' <<<"$out")"
    say "$resolved/$total resolved"
    jq -r '.[] | select(.argv == null) | "  ! \(.class): no command found"' <<<"$out"
}

# ── install ──────────────────────────────────────────────────────────────────
write_units() {
    mkdir -p "$UNIT_DIR"
    local interval; interval="$(config_get saveIntervalSec "$DEFAULT_SAVE_INTERVAL")"

    # Anchored on default.target, not graphical-session.target. The obvious
    # choice was wrong, and only a real reboot caught it: on this lab's Omarchy
    # 4 (SDDM autologin -> /usr/bin/start-hyprland -> Hyprland, no UWSM session
    # unit in between), graphical-session.target is a loaded but permanently
    # inactive definition -- nothing ever starts it, so a timer WantedBy=it
    # never comes back after a reboot even though `systemctl --user
    # is-enabled` still says "enabled". Measured: after a spontaneous VM
    # restart, autostart.lua's `restore --if-enabled` ran (confirmed in the
    # journal) and windows came back, but the snapshot timer stayed inactive
    # the whole time -- silently. default.target is the one target this host
    # actually reaches for a graphical login (confirmed active in the same
    # session), and every other login manager reaches it too, since it is
    # where systemd itself lands any user session.
    #
    # The cost of anchoring here instead of a graphical-session target: the
    # timer also runs for a plain SSH login with no Hyprland at all. That is
    # harmless by construction, not by luck -- session-save.sh's own guard
    # exits 3 ("cannot read hyprctl clients") without touching anything when
    # there is no compositor to read, and 3 is already in SuccessExitStatus
    # below.
    cat > "$UNIT_DIR/omasession-snapshot.service" <<UNIT
[Unit]
Description=OmaSession session snapshot

[Service]
Type=oneshot
ExecStart=$SELF/bin/omasession save
# The guard reports 3 when it refuses and 4 when another save holds the lock.
# Both are correct outcomes, not failures: without this systemd marks the unit
# failed and the user is told something broke when nothing did.
SuccessExitStatus=3 4
UNIT

    cat > "$UNIT_DIR/omasession-snapshot.timer" <<UNIT
[Unit]
Description=OmaSession session snapshot

[Timer]
OnActiveSec=${interval}s
OnUnitActiveSec=${interval}s
AccuracySec=1s

[Install]
WantedBy=default.target
UNIT
    say "units written to $UNIT_DIR (every ${interval}s)"
}

autostart_line() { printf 'o.launch_on_start("%s/bin/omasession restore --if-enabled")' "$SELF"; }

# Um unico backup, tirado antes da primeira modificacao e nunca sobrescrito.
# Marcador: toda edição nossa no autostart.lua carrega um destes, porque o
# desfazer tem de ser cirúrgico -- restaurar o arquivo inteiro do backup apaga
# o que o usuário adicionou DEPOIS do install. Medido na revisão -- install, o
# usuário acrescenta um app, uninstall, e o app dele some.
MARK_LOGIN="-- OmaSession: reopen the last session at login"

# Marcador de uma versão anterior deste script (antes de 13bcaca), que
# desarmava o autostart do hyprresume no install porque os dois escreviam os
# mesmos arquivos. Não competimos mais -- capturamos por conta própria, em
# diretório separado -- então o install de hoje não desarma nada. Mas quem
# instalou aquela versão tem essa linha comentada no autostart.lua até hoje, e
# sem desfazê-la aqui o uninstall nunca a alcança: achado da revisão, "uninstall
# anuncia sucesso e a alteração legada fica pra trás".
LEGACY_MARK_DISARM="-- omasession: disarmed, see docs/DESIGN.md §2 -- "

rearm_legacy_hyprresume() {
    [[ -f "$AUTOSTART" ]] || return 0
    grep -qF -- "$LEGACY_MARK_DISARM" "$AUTOSTART" || return 0
    local tmp; tmp="$(mktemp "$AUTOSTART.XXXXXX")"
    sed "s|^${LEGACY_MARK_DISARM}||" "$AUTOSTART" > "$tmp" && mv -f "$tmp" "$AUTOSTART"
    say "hyprresume re-armed in autostart.lua (leftover from an older install)"
}

backup_autostart() {
    [[ -f "$AUTOSTART" ]] || return 0
    # Preservado para recuperação manual, nunca aplicado automaticamente.
    [[ -f "$AUTOSTART.omasession.bak" ]] || cp -p "$AUTOSTART" "$AUTOSTART.omasession.bak"
}

add_login_restore() {
    [[ -f "$AUTOSTART" ]] || { err "no $AUTOSTART -- skipping login restore"; return; }
    if grep -qF "omasession restore" "$AUTOSTART"; then
        say "login restore already in autostart.lua"
        return
    fi
    backup_autostart
    printf '\n%s\n%s\n' "$MARK_LOGIN" "$(autostart_line)" >> "$AUTOSTART"
    say "login restore added to autostart.lua"
}

remove_login_restore() {
    [[ -f "$AUTOSTART" ]] || return 0
    grep -qF "omasession restore" "$AUTOSTART" || return 0
    local tmp; tmp="$(mktemp "$AUTOSTART.XXXXXX")"
    # Remove a linha marcada e a nossa logo abaixo, e nada mais.
    # Segura uma linha em branco antes de imprimir: o install insere uma antes
    # do marcador, e deixá-la para trás faz o ciclo install/uninstall não
    # devolver o arquivo idêntico -- o que estraga a única checagem barata de
    # que o desfazer está completo.
    awk -v mark="$MARK_LOGIN" '
        $0 == mark            { held = 0; skip = 1; next }
        skip && /omasession restore/ { skip = 0; next }
        /^[[:space:]]*$/      { if (held) print heldline; heldline = $0; held = 1; next }
                              { if (held) { print heldline; held = 0 } skip = 0; print }
        END                   { if (held) print heldline }
    ' "$AUTOSTART" > "$tmp" && mv -f "$tmp" "$AUTOSTART"
    if grep -qF "omasession restore" "$AUTOSTART"; then
        err "an omasession line in autostart.lua was not written by install and was left alone"
    else
        say "login restore removed from autostart.lua"
    fi
}

# O diretório fixo de antes de 13bcaca -- não o $SESSION_DIR de hoje, que
# pode até ser o mesmo se OMASESSION_SESSION_DIR estiver setado pra lá, mas o
# caminho onde sessões de uma instalação anterior objetivamente estariam é
# sempre este, independente de qualquer override atual.
LEGACY_SESSION_DIR="$HOME/.local/share/hyprresume/sessions"

migrate_legacy_session() {
    # Só se o novo diretório ainda não tem nada: nunca sobrescreve uma sessão
    # que o novo capturador já salvou. Achado da revisão: sem isto, quem
    # atualiza e reinicia antes do primeiro save novo perde a última sessão
    # boa que tinha -- o restore de login pode cair nesse intervalo.
    [[ -f "$SESSION_DIR/last.toml" ]] && return 0
    [[ -f "$LEGACY_SESSION_DIR/last.toml" ]] || return 0
    local f
    for f in last.toml last.titles.json last.prev.toml last.prev.titles.json; do
        [[ -f "$LEGACY_SESSION_DIR/$f" ]] && cp -p "$LEGACY_SESSION_DIR/$f" "$SESSION_DIR/$f"
    done
    say "migrated last saved session from $LEGACY_SESSION_DIR (hyprresume's old directory, left untouched there)"
}

cmd_install() {
    command -v jq >/dev/null || die "jq is required"
    command -v python3 >/dev/null || die "python3 is required"

    mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$SESSION_DIR"
    migrate_legacy_session
    if [[ ! -f "$CONFIG" ]]; then
        jq -n --argjson i "$DEFAULT_SAVE_INTERVAL" \
              --argjson r "$DEFAULT_RESTORE_ON_LOGIN" \
              --argjson b "$DEFAULT_BROWSER_RESTORE" \
              '{saveIntervalSec:$i, restoreOnLogin:$r, browserRestore:$b}' > "$CONFIG"
        say "config written to $CONFIG"
    fi

    # Disable before rewriting: `enable` never removes a symlink left by an
    # older [Install] section, so upgrading from a version anchored on a
    # different target (graphical-session.target -- see write_units for why
    # that one turned out wrong) would leave a stale .wants/ symlink pointing
    # at the now-rewritten file, active by whichever target happens to start.
    systemctl --user disable --now omasession-snapshot.timer >/dev/null 2>&1 || true
    write_units
    systemctl --user daemon-reload
    systemctl --user enable --now omasession-snapshot.timer >/dev/null 2>&1 \
        && say "snapshot timer enabled" \
        || err "could not enable the timer (no systemd user session?)"

    # A linha entra sempre; ligar e desligar é com o config, que o painel
    # escreve e que `restore --if-enabled` consulta no login.
    add_login_restore

    if [[ ! -f /etc/chromium/policies/managed/omasession-no-promo.json \
       && ! -f /etc/opt/chrome/policies/managed/omasession-no-promo.json ]]; then
        err "browser policy not installed -- run: sudo $SELF/bin/browser-setup"
    fi
    say "installed"
}

cmd_uninstall() {
    systemctl --user disable --now omasession-snapshot.timer >/dev/null 2>&1 || true
    rm -f "$UNIT_DIR/omasession-snapshot.timer" "$UNIT_DIR/omasession-snapshot.service"
    systemctl --user daemon-reload 2>/dev/null || true
    # Desfaz só o que instalamos. Restaurar o backup inteiro descartaria tudo
    # que o usuário editou depois do install -- P0 da rodada 2.
    remove_login_restore
    rearm_legacy_hyprresume
    if [[ -f "$AUTOSTART.omasession.bak" ]]; then
        say "backup kept at $(basename "$AUTOSTART").omasession.bak (not applied)"
    fi
    say "uninstalled -- saved sessions in $SESSION_DIR were left alone"
}

# ── config ───────────────────────────────────────────────────────────────────
# The one write path into config.json outside `install`. The panel is the
# reason this exists: DESIGN.md §6 keeps every write out of Panel.qml, so a
# toggle in the UI cannot poke the file itself -- it has to ask the CLI, same
# as save/restore. Writing straight from QML would also duplicate the typing
# rules below in a second language.
cmd_config() {
    local sub="${1:-}"
    case "$sub" in
        get)
            local key="${2:?usage: omasession config get <key>}"
            config_get "$key" ""
            ;;
        set)
            local key="${2:?usage: omasession config set <key> <value>}"
            local value="${3:?usage: omasession config set <key> <value>}"
            mkdir -p "$CONFIG_DIR"
            [[ -f "$CONFIG" ]] || echo '{}' > "$CONFIG"
            # true/false/numbers stay bare JSON; anything else is a JSON string.
            # A key that does not already round-trip through jq is rejected
            # rather than written half-typed.
            local typed
            case "$value" in
                true|false|[0-9]*) typed="$value" ;;
                *) typed="$(jq -Rn --arg v "$value" '$v')" ;;
            esac
            jq --arg k "$key" --argjson v "$typed" '.[$k] = $v' "$CONFIG" \
                > "$CONFIG.tmp" && mv -f "$CONFIG.tmp" "$CONFIG"
            say "$key = $value"
            ;;
        *) die "usage: omasession config get|set <key> [value]" ;;
    esac
}

usage() { sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
    save)      shift; cmd_save "$@" ;;
    restore)   shift; cmd_restore "$@" ;;
    status)    shift; cmd_status "$@" ;;
    resolve)   shift; cmd_resolve "$@" ;;
    install)   shift; cmd_install "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    config)    shift; cmd_config "$@" ;;
    -h|--help|help|"") usage ;;
    *) err "unknown command: $1"; usage; exit 1 ;;
esac
