#!/usr/bin/env bash
# Where the Chromium-family policy file that suppresses onboarding screens
# WOULD go for each vendor, one per line -- omasession install/uninstall use
# this to check whether the manual step documented in the README has been
# done. This script never writes anything itself, and never needs root.
#
# It used to also WRITE that policy, as root, via `--install` (the default)
# and remove it via `--remove`, calling lib/browser_policy.py and
# lib/verify_path.py to do it safely -- removed. Achado da revisão de
# segurança do marketplace (github.com/omacom/omarchy-plugin-marketplace/
# issues/6243, HANCORE-linux, follow-up de 2026-09-12): não importa quão
# seguras as escritas em si fossem contra symlink -- e as duas rodadas
# anteriores as tornaram genuinamente seguras, TOCTOU incluído -- `sudo`
# carregando este script (e os dois que ele chamava) do checkout git do
# próprio usuário é uma travessia real de fronteira de privilégio: qualquer
# processo rodando como esse mesmo usuário (não precisa ser root) podia
# reescrever esses arquivos antes do humano digitar o `sudo` documentado, e
# o código substituído rodaria como root. PATH fixo e escrita segura contra
# symlink nunca resolveram isso, porque nunca autenticavam os BYTES do
# próprio script.
#
# A troca: o README agora documenta dois comandos literais (`install -D -T
# -m 644` pra escrever, `rm -f` pra desfazer) rodando sobre dado fixo, com
# `sudo` direto -- nenhum arquivo deste checkout é carregado por root em
# momento nenhum. Medido: `install -D -T -m 644` tem a mesma propriedade
# que lib/browser_policy.py existia pra ter -- não segue um symlink
# plantado no nome final (substitui a entrada, como o `os.rename()` de
# antes; o `-T` é o que garante isso, sem ele um symlink-para-diretório
# nesse nome faz o `install` copiar PRA DENTRO dele em vez de substituir,
# achado da revisão), e cria o diretório que falta com o mesmo modo (0755)
# que o helper Python usava, imune ao umask de quem roda o sudo.
#
# Resíduo conhecido, não fechado de propósito: `install -D` ainda segue um
# symlink plantado num componente de DIRETÓRIO no meio do caminho (não no
# nome final) -- diferente do que O_NOFOLLOW por componente garantia. Não
# é regressão prática: todo componente de `/etc` pra baixo é normalmente
# root-owned 0755 num sistema são, então alcançar esse resíduo já exige
# ser root (ou um pacote do sistema quebrado) -- exatamente o privilégio
# que o achado desta rodada existia pra não precisar ter de antemão.
# Fechar isso reintroduziria lógica condicional do checkout rodando como
# root, o problema oposto do que esta mudança resolve.
set -euo pipefail

declare -A POLICY_DIRS=(
    [google-chrome]=/etc/opt/chrome/policies/managed
    [chromium]=/etc/chromium/policies/managed
    [brave]=/etc/brave/policies/managed
    [vivaldi]=/etc/vivaldi/policies/managed
    [edge]=/etc/opt/edge/policies/managed
)

case "${1:-}" in
    --list-paths) ;;
    *)
        printf 'browser-setup: %s\n' \
            "unknown option: ${1:-} (only --list-paths is supported -- see the README for the manual policy install/removal command)" >&2
        exit 1
        ;;
esac

for vendor in "${!POLICY_DIRS[@]}"; do
    printf '%s/omasession-no-promo.json\n' "${POLICY_DIRS[$vendor]}"
done
